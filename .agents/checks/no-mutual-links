#!/bin/sh
# 指令面链接方向守卫：完整扫描面与入口命名豁免见 docs/agents/agent-context.md「链接方向」。
# 互指图只解析行内 Markdown `[label](target)` 链接，沿用 validate-context.mjs 的链接提取口径；
# 引用式 `[label][id]` 不纳入既定判据。
# 新增入口文档用全大写文件名；任一端命中 ^[A-Z0-9_-]+\.md$ 的互指对豁免。
set -eu

tmpdir=${TMPDIR:-/tmp}/no-mutual-links.$$
if ! mkdir "$tmpdir"; then
  echo "no-mutual-links cannot run: could not create a temporary directory" >&2
  exit 1
fi
trap 'rm -rf "$tmpdir"' 0 HUP INT TERM

files="$tmpdir/files"
locked="$tmpdir/locked"
links="$tmpdir/links"
: > "$files"
: > "$links"

add_file() {
  [ -f "$1" ] && printf '%s\n' "$1" >> "$files"
  return 0
}

add_tree() {
  directory=$1
  find "$directory" -type f -name '*.md' -print 2>/dev/null || return 1
}

# 复刻 validate-context.mjs 的 markdownFiles：五个可选根入口、docs、.agents（排除上游件）、
# 自撰 skill 的消费路径、skills 根 README、包级 AGENTS 与 workspace 根 README。
for file in AGENTS.md CLAUDE.md CONTEXT.md ARCHITECTURE.md CONTRIBUTING.md; do
  add_file "$file"
done

for directory in docs/agents docs/adr .agents; do
  if [ -d "$directory" ]; then
    add_tree "$directory" >> "$files" || {
      echo "no-mutual-links cannot run: failed to scan $directory" >&2
      exit 1
    }
  fi
done

if [ ! -r skills-lock.json ]; then
  echo "no-mutual-links cannot run: skills-lock.json is missing or unreadable" >&2
  exit 1
fi
sed -n 's/^    "\([^"]*\)": {$/\1/p' skills-lock.json > "$locked"

# `.agents/skills-vendored` 中锁定上游件不属于本仓语料；其他 .agents Markdown 保留。
awk -F/ '
  FILENAME == ARGV[1] { locked[$1] = 1; next }
  {
    if ($1 == ".agents" && $2 == "skills-vendored" && locked[$3]) next
    print
  }
' "$locked" "$files" > "$tmpdir/unfiltered"
mv "$tmpdir/unfiltered" "$files"

# 根 skills/ 的 README 是独立门面；skill 正文按消费面 `.agents/skills/` 归一，且跳过锁定上游件。
add_file skills/README.md
if [ -d skills ]; then
  if ! find skills -type f -name '*.md' -print > "$tmpdir/skill-files" 2>/dev/null; then
    echo "no-mutual-links cannot run: failed to scan skills" >&2
    exit 1
  fi
  while IFS= read -r file; do
    case "$file" in
      skills/*/*) ;;
      *) continue ;;
    esac
    skill=${file#skills/}
    name=${skill%%/*}
    if ! grep -F -x "$name" "$locked" >/dev/null 2>&1; then
      printf '.agents/skills/%s\n' "$skill" >> "$files"
    fi
  done < "$tmpdir/skill-files"
fi

for directory in packages apps; do
  if [ -d "$directory" ]; then
    find "$directory" -type f -name AGENTS.md -print 2>/dev/null >> "$files" || {
      echo "no-mutual-links cannot run: failed to scan $directory AGENTS.md files" >&2
      exit 1
    }
    for child in "$directory"/* "$directory"/.[!.]* "$directory"/..?*; do
      [ -d "$child" ] && [ ! -L "$child" ] || continue
      add_file "$child/README.md"
    done
  fi
done

LC_ALL=C sort -u "$files" -o "$files"
file_count=$(awk 'END { print NR + 0 }' "$files")
if [ "$file_count" -eq 0 ]; then
  echo "no-mutual-links cannot run: instruction scan found 0 Markdown files" >&2
  exit 1
fi

# 路径只含仓库相对名；Markdown 链接目标里的 fragment 与外链不参与文件图。
while IFS= read -r source; do
  actual=$source
  case "$source" in
    .agents/skills/*)
      actual="skills/${source#.agents/skills/}"
      ;;
  esac
  if [ ! -r "$actual" ]; then
    echo "no-mutual-links cannot read scan entry: $source" >&2
    exit 1
  fi
  awk -v source="$source" '
    { document = document $0 "\n" }
    END {
      rest = document
      while (match(rest, /\[[^]]*\]\([^)]*\)/)) {
        token = substr(rest, RSTART, RLENGTH)
        before = substr(rest, 1, RSTART - 1)
        if (before !~ /!$/) {
          target = token
          sub(/^.*\]\(/, "", target)
          sub(/\)$/, "", target)
          gsub(/[[:space:]]+/, " ", target)
          sub(/^[[:space:]]+/, "", target)
          if (substr(target, 1, 1) == "<") {
            sub(/^</, "", target)
            sub(/>.*/, "", target)
          } else {
            sub(/[[:space:]].*$/, "", target)
          }
          if (target != "") print source "\t" target
        }
        rest = substr(rest, RSTART + RLENGTH)
      }
    }
  ' "$actual" >> "$links"
done < "$files"

awk -F '\t' -v files="$files" -v file_count="$file_count" '
  function normalize(path, parts, count, i, segment, result) {
    count = split(path, parts, "/")
    depth = 0
    for (i = 1; i <= count; i++) {
      segment = parts[i]
      if (segment == "" || segment == ".") continue
      if (segment == "..") {
        if (depth > 0) depth--
      } else {
        stack[++depth] = segment
      }
    }
    result = ""
    for (i = 1; i <= depth; i++) result = result (i == 1 ? "" : "/") stack[i]
    return result
  }
  function basename(path, parts, count) {
    count = split(path, parts, "/")
    return parts[count]
  }
  BEGIN {
    while ((getline path < files) > 0) known[path] = 1
    close(files)
  }
  {
    source = $1
    target = $2
    if (target == "" || target ~ /^(https?:|mailto:|#)/ || target ~ /^\//) next
    sub(/#.*/, "", target)
    if (target == "") next
    directory = source
    sub(/\/[^\/]*$/, "", directory)
    if (directory == source) directory = "."
    target = normalize(directory "/" target)
    if (!known[target]) next

    if (source ~ /^docs\/agents\// && target ~ /^\.agents\/rules\//) {
      rule_edges[source SUBSEP target] = 1
    }
    if (!edge[source SUBSEP target]++) edge_count++
  }
  END {
    if (edge_count == 0) {
      print "no-mutual-links cannot run: instruction scan found 0 local Markdown links" > "/dev/stderr"
      exit 2
    }
    violations = 0
    for (key in rule_edges) {
      split(key, pair, SUBSEP)
      printf "docs-to-rules link forbidden: %s -> %s\n", pair[1], pair[2]
      violations++
    }
    for (key in edge) {
      split(key, pair, SUBSEP)
      source = pair[1]
      target = pair[2]
      if (source >= target || !(edge[target SUBSEP source])) continue
      if (basename(source) ~ /^[A-Z0-9_-]+[.]md$/ || basename(target) ~ /^[A-Z0-9_-]+[.]md$/) continue
      printf "mutual links forbidden: %s <-> %s\n", source, target
      violations++
    }
    if (violations > 0) exit 1
    printf "no-mutual-links passed (%d Markdown files, %d local edges)\n", file_count, edge_count
  }
' "$links"
