<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="weave"
        Arguments=""
        InstallLocation="C:\Program Files\greypan\Weave">
    </Installer>
    <PackageInformation
        PackageName="Weave"
        PackageDisplayName="Weave"
        PublisherName="CN=greypan"
        PublisherDisplayName="greypan"
        Version="0.1.0.0"
        PackageDescription="Weave desktop application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.greypan.weave"
                Description="Weave desktop application"
                DisplayName="Weave"
                ExecutableName="weave"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Weave</DisplayName>
            <PublisherDisplayName>greypan</PublisherDisplayName>
            <Description>Weave desktop application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="weave.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
