{
  "extends": "@greypan/tsconfig/vue.json",
  "exclude": ["src/**/__tests__/*"],
  "include": ["src/**/*", "src/**/*.vue", "env.d.ts", "bindings"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@bindings/weave/*": ["./bindings/github.com/pan-Z2l0aHVi/mono/apps/weave/*"],
      "@bindings/*": ["./bindings/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
