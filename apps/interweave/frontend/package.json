    "@wailsio/runtime": "catalog:",
    "lit": "catalog:",
    "overlayscrollbars": "catalog:",
    "overlayscrollbars-vue": "catalog:",
    "pinia": "catalog:",
    "virtua": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@greypan/deps-reload": "workspace:*",
    "@greypan/js-kit": "workspace:*",
    "@greypan/monorepo-kit": "workspace:*",
    "@greypan/tsconfig": "workspace:*",
    "@greypan/unplugin-web-components": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "tailwindcss": "catalog:",
    "unplugin-auto-import": "catalog:",
