{
  "name": "@greypan/interweave-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vp test run",
    "dev": "vp dev",
    "build:dev": "node ../scripts/generate-bindings.mjs && pnpm run build:bundle:dev",
    "build": "node ../scripts/generate-bindings.mjs && pnpm run build:bundle",
    "preview": "vp preview",
    "build:bundle:dev": "vue-tsc --build && vp build --minify false --mode development",
    "build:bundle": "vue-tsc --build && vp build --mode production"
  },
  "dependencies": {
    "@greypan/app-scrollbars": "workspace:*",
