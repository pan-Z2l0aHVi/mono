{
  "name": "@greypan/interweave",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:frontend": "pnpm --dir frontend run build",
    "build:macos": "wails3 task darwin:package:dmg ARCH=arm64",
    "build:windows": "wails3 build GOOS=windows GOARCH=amd64",
    "dev": "wails3 dev",
    "sync:version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@greypan/interweave-frontend": "workspace:*"
  }
}
