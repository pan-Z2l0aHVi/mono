{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!frontend/bindings/**",
        "!frontend/auto-imports.d.ts",
        "!frontend/typed-router.d.ts",
        "!docs/**",
        "!**/*.md",
        "!**/*.spec.ts",
        "!**/*.spec.mjs",
        "!**/*.test.ts",
        "!**/*.test.mjs",
        "!**/__tests__/**",
        "!**/*_test.go"
      ],
      "outputs": ["bin/**"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!frontend/bindings/**",
        "!frontend/auto-imports.d.ts",
        "!frontend/typed-router.d.ts",
        "!docs/**",
        "!**/*.md",
        "!**/*.spec.ts",
        "!**/*.spec.mjs",
        "!**/*.test.ts",
        "!**/*.test.mjs",
        "!**/__tests__/**"
      ]
    }
  }
}
