{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!docs/**",
        "!**/*.md",
        "!**/*.spec.ts",
        "!**/*.spec.mjs",
        "!**/*.test.ts",
        "!**/*.test.mjs",
        "!**/__tests__/**",
        "!**/*_test.go"
      ],
      "outputs": ["bin/**", "frontend/dist/**"]
    }
  }
}
