{
  "extends": "@greypan/tsconfig/node.json",
  "include": ["src/**/*.mjs"],
  "exclude": ["src/**/__tests__/**"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "noImplicitAny": false
  }
}
