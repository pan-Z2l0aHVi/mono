{
  "name": "@greypan/browser-kit",
  "version": "3.0.1",
  "description": "Browser utility functions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pan-Z2l0aHVi/mono.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "dev": "vp pack --watch --clean=false"
  },
  "dependencies": {
    "@greypan/js-kit": "workspace:*",
    "copy-to-clipboard": "catalog:",
    "nanoid": "catalog:",
    "remeda": "catalog:"
  },
  "devDependencies": {
    "@greypan/monorepo-kit": "workspace:*",
    "@greypan/test-kit": "workspace:*",
    "@greypan/tsconfig": "workspace:*",
    "msw": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
