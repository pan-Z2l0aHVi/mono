{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.spec.mjs",
        "!**/*.test.ts",
        "!**/*.test.mjs",
        "!**/__tests__/**",
        "!README.md",
        "!README.CN.md",
        "!AGENTS.md",
        "!CHANGELOG.md"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!README.CN.md",
        "!AGENTS.md",
        "!CHANGELOG.md",
        "$TURBO_ROOT$/apps/react-web-ui-demo/src/generated/**",
        "$TURBO_ROOT$/apps/react-web-ui-demo/src/routes/components/**",
        "$TURBO_ROOT$/apps/vue-web-ui-demo/src/generated/**",
        "$TURBO_ROOT$/apps/vue-web-ui-demo/src/pages/components/**"
      ]
    }
  }
}
