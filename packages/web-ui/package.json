{
  "name": "@greypan/web-ui",
  "version": "12.4.0",
  "description": "Lit-based web components for React, Vue, and vanilla JS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pan-Z2l0aHVi/mono.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./src/components/**",
    "./dist/components/**",
    "./src/classes/**",
    "./dist/classes/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./classes.css": "./dist/classes/style.css",
    "./types/*": "./dist/types/*.d.ts",
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "dev": "vp pack --watch --clean=false",
    "generate-icons": "node --experimental-strip-types scripts/generate-icons.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@greypan/browser-kit": "workspace:*",
    "@greypan/js-kit": "workspace:*",
    "@iconify/types": "catalog:",
    "@lit/context": "catalog:"
  },
  "devDependencies": {
    "@greypan/monorepo-kit": "workspace:*",
    "@greypan/tsconfig": "workspace:*",
    "@iconify-json/akar-icons": "catalog:",
    "@iconify-json/andrsrxn": "catalog:",
    "@iconify-json/ant-design": "catalog:",
    "@iconify-json/bi": "catalog:",
    "@iconify-json/ci": "catalog:",
    "@iconify-json/codex": "catalog:",
    "@iconify-json/emojione-monotone": "catalog:",
    "@iconify-json/fluent": "catalog:",
    "@iconify-json/heroicons": "catalog:",
    "@iconify-json/ic": "catalog:",
    "@iconify-json/icon-park-outline": "catalog:",
    "@iconify-json/icon-park-solid": "catalog:",
    "@iconify-json/ix": "catalog:",
    "@iconify-json/jam": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/mdi": "catalog:",
    "@iconify-json/ooui": "catalog:",
    "@iconify-json/radix-icons": "catalog:",
    "@iconify-json/si": "catalog:",
    "@iconify-json/tabler": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "lit": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@types/react": ">=19",
    "lit": "catalog:",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "browserslist": [
    "Chrome >=111",
    "Edge >=111",
    "Safari >=16.4",
    "iOS >=16.4",
    "Firefox >=128",
    "not dead"
  ]
}
