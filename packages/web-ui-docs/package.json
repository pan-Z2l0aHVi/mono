{
  "name": "@greypan/web-ui-docs",
  "version": "0.0.0",
  "private": true,
  "description": "web-ui 示例文档引擎：把 docs/examples 的 markdown 生成两个 demo 的示例数据与可交互组件源码",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "dev": "vp pack --watch --clean=false"
  },
  "dependencies": {
    "hast-util-to-html": "catalog:",
    "js-yaml": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "shiki": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@greypan/tsconfig": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
