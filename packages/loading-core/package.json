  "description": "Framework-agnostic loading primitives: progress bar, splash dismissal, chunk recovery, and route announcements",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pan-Z2l0aHVi/mono.git"
  },
  "type": "module",
