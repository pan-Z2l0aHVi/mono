{
  "extends": [
    "stylelint-config-clean-order",
    "stylelint-config-standard",
    "stylelint-config-standard-vue",
    "stylelint-config-html"
  ],
  "ignoreFiles": ["**/generated/**"],
  "rules": {
    "alpha-value-notation": "number",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["theme", "utility", "custom-variant"]
      }
    ],
    "declaration-block-no-redundant-longhand-properties": null,
    "no-empty-source": null,
    "declaration-empty-line-before": null,
    "custom-property-empty-line-before": null,
    "import-notation": "string"
  },
  "overrides": [
    {
      "files": ["apps/vue-web-ui-demo/src/assets/global.css", "apps/react-web-ui-demo/src/assets/global.css"],
      "rules": {
        "at-rule-no-unknown": [
          true,
          {
            "ignoreAtRules": ["theme", "utility", "custom-variant", "source"]
          }
        ]
      }
    }
  ]
}
