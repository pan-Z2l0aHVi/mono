{
  "name": "mono",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "clean": "bash scripts/clean.sh",
    "staged": "vp staged",
    "build": "turbo build",
    "test": "turbo test",
    "commit": "git-cz",
    "commit:ci": "bash scripts/commit.sh",
    "publish:new": "bash scripts/publish-new-pack.sh",
    "release:version": "node scripts/release-version.mjs",
    "dev:react-web-ui-demo": "turbo build --filter=@greypan/react-web-ui-demo^... && turbo run dev --filter=@greypan/react-web-ui-demo...",
    "dev:vue-web-ui-demo": "turbo build --filter=@greypan/vue-web-ui-demo^... && turbo run dev --filter=@greypan/vue-web-ui-demo...",
    "dev:interweave": "turbo build --filter=@greypan/interweave^... && turbo run dev --filter=@greypan/interweave --filter=@greypan/interweave-frontend^...",
    "validate:context": "node scripts/validate-context.mjs",
    "find:usages": "node scripts/repo-query.mjs verify",
    "audit:instructions": "node scripts/audit-instructions.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "test:scripts": "node scripts/scripts.test.mjs",
    "inspect:contract": "node scripts/repo-query.mjs contract",
    "diff:contract": "node scripts/repo-query.mjs contract-diff",
    "check:code": "pnpm run check:cspell && vp check && pnpm run check:go",
    "check:go": "! gofmt -l . | grep -q . && find . -name go.mod -not -path \"*/node_modules/*\" -exec dirname {} \\; | sort -u | xargs -I{} sh -c \"cd {} && go vet ./...\"",
    "check:stylelint": "pnpm exec stylelint --allow-empty-input \"**/*.{css,scss,less,html,vue}\"",
    "check:cspell": "pnpm exec cspell --no-progress --no-must-find-files \"**/*.{js,ts,jsx,tsx,mjs,cjs,html,vue,css,less,scss,go}\"",
    "fix:go": "gofmt -w . && find . -name go.mod -not -path \"*/node_modules/*\" -exec dirname {} \\; | sort -u | xargs -I{} sh -c \"cd {} && go vet ./...\"",
    "fix:stylelint": "pnpm exec stylelint --fix --allow-empty-input \"**/*.{css,scss,less,html,vue}\"",
    "fix:code": "vp check --fix && pnpm run fix:go && pnpm run fix:stylelint"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@cspell/dict-lorem-ipsum": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "postcss-html": "catalog:",
    "browserslist": "catalog:",
    "commitizen": "catalog:",
    "cspell": "catalog:",
    "cz-git": "catalog:",
    "glob": "catalog:",
    "jsdom": "catalog:",
    "lightningcss": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-clean-order": "catalog:",
    "stylelint-config-html": "catalog:",
    "stylelint-config-recommended-vue": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-config-standard-vue": "catalog:",
    "stylelint-prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0"
}
