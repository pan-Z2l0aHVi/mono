{
  "name": "vite-plus-turbo-osc11-repro",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "build": "turbo build",
    "test": "turbo test",
    "probe": "python3 tools/osc-probe.py -- pnpm run build",
    "probe:control": "python3 tools/osc-probe.py -- node packages/osc11-query/src/query-terminal.mjs",
    "probe:vite-plus": "python3 tools/osc-probe.py -- pnpm exec turbo build --filter=@greypan/js-kit --force"
  },
  "devDependencies": {
