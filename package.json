    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=12.4.0"
  },
  "packageManager": "pnpm@12.4.0"
}
