{
  "allowCompoundWords": true,
  "dictionaries": ["en_US", "typescript", "node", "npm", "html", "css", "lorem-ipsum"],
  "ignorePaths": [
    "**/.git/**",
    "**/.*ignore",
    "**/*.lock",
    "**/*-lock.yaml",
    "**/*-lock.json",
    "**/package.json",
    "**/*.d.ts",
    "**/*.{svg,png,jpg,jpeg,gif,ico,woff,woff2,ttf,eot}",
    "**/.vscode/**",
    "**/.zed/**",
    "apps/interweave/build/**",
    "apps/interweave/frontend/bindings/**",
    "**/go.sum",
    "**/go.mod",
    "**/routeTree.gen.ts",
    "**/auto-imports.d.ts",
    "**/typed-router.d.ts"
  ],
  "ignoreRegExpList": [
    // 忽略 hex 十六进制颜色
    "#[a-fA-F0-9]{3,6}",
    // 忽略 react 自定义事件（例如：onvisible-change）
    "\\bon[a-z-]{4,}\\b"
  ],
  "useGitignore": true,
  "version": "0.2",
  "words": [
    "Avenir",
    "entrancy",
    "evals",
    "iconify",
    "kalimahapps",
    "regen",
    "tabler",
    "turborepo",
    "unplugin",
    "Vetur",
    "vueuse",
    "Grey Pan",
    "unhead",
    "Debouncer",
    "oxlint",
    "tsgo",
    "nsis",
    "pkill",
    "unstub",
    "indexeddb",
    "ooui",
    "wailsio",
    "WAAPI",
    "ENEEDAUTH",
    "oxfmt",
    "idref",
    "retarget",
    "pple",
    "gofmt",
    "GOARCH",
    "ACMR",
    "nodir",
    "modernc",
    "dedup",
    "maint",
    "taggings",
    "cooccurring"
  ]
}
