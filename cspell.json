{
  "allowCompoundWords": true,
  "dictionaries": ["en_US", "typescript", "node", "npm", "html", "css", "lorem-ipsum"],
  "ignorePaths": [
    "**/.git/**",
    "**/.*ignore",
    "**/*.lock",
    "**/*-lock.yaml",
    "**/*-lock.json",
    "**/package.json",
    "**/*.d.ts",
    "**/*.{svg,png,jpg,jpeg,gif,ico,woff,woff2,ttf,eot}",
    "**/.vscode/**",
    "**/.zed/**",
    "apps/interweave/build/**",
    "apps/interweave/frontend/bindings/**",
    "**/go.sum",
    "**/go.mod",
    "**/routeTree.gen.ts",
    "**/auto-imports.d.ts",
    "**/typed-router.d.ts"
  ],
  "ignoreRegExpList": [
    // 忽略 hex 十六进制颜色
    "#[a-fA-F0-9]{3,6}",
    // 忽略 react 自定义事件（例如：onvisible-change）
    "\\bon[a-z-]{4,}\\b",
    // 忽略 percent-encode 出来的转义（`%3Csvg`、`%234f46e5`）：内联 data URI 的组成部分，
    // 示例图靠它做到不带二进制素材、不依赖网络，按词判只会把人逼回外链素材。
    "%[0-9A-Fa-f]{2}[A-Za-z0-9]*"
  ],
  "useGitignore": true,
  "version": "0.2",
  "words": [
    "punct",
    "unacked",
    "seqs",
    "unsynchronised",
    "unconsumable",
    "recognised",
    "realpathed",
    "observ",
    "acked",
    "ackable",
    "acking",
    "acks",
    "Acking",
    "cand",
    "cosa",
    "Cwds",
    "splitCwds",
    "splitCwd",
    "inconsolata",
    "Inconsolata",
    "Avenir",
    "entrancy",
    "evals",
    "iconify",
    "andrsrxn",
    "kalimahapps",
    "regen",
    "tabler",
    "turborepo",
    "unplugin",
    "Vetur",
    "vueuse",
    "virtua",
    "Grey Pan",
    "unhead",
    "Debouncer",
    "oxlint",
    "tsgo",
    "nsis",
    "pkill",
    "unstub",
    "unhover",
    "unrouted",
    "indexeddb",
    "ooui",
    "wailsio",
    "WAAPI",
    "ENEEDAUTH",
    "oxfmt",
    "idref",
    "tabbable",
    "tabbables",
    "hresult",
    "shlwapi",
    "retarget",
    "retargeted",
    "reattributed",
    "pple",
    "gofmt",
    "GOCACHE",
    "gocache",
    "GOARCH",
    "gpgsign",
    "ACMR",
    "ACMRD",
    "nodir",
    "modernc",
    "dedup",
    "maint",
    "taggings",
    "cooccurring",
    "vnode",
    "herdr",
    "akar",
    "alac",
    "HDROP",
    "NSJSON",
    "NSPasteboard",
    "NSURL",
    "NSUTF",
    "xclip",
    "fsnotify",
    "servability",
    "dedups",
    "klmnopqrst",
    "browserv",
    "WCAG",
    "CSSWG",
    "vdom",
    "Tera",
    "shiki",
    "shikijs",
    "SHIKI",
    "Segoe",
    "menlo",
    "consolas",
    "pxpx",
    // 「长串断词」示例的 opaque 值：语料里写一次，生成器把它复制进两端的 demo 产物。
    // 之前用一条 `[A-Z0-9]{16,}` 放过整类，代价是全仓永久不再检查任何长大写串，所以改成按字面量登记。
    "AAAABBBBCCCCDDDDEEEE",
    // autocomplete 语料里的城市名（中文 label + 拼音 value）。
    "shenzhen",
    // 壳文案 i18n：库名与 Gettext PO 的字段名（msgid / msgstr 由字典放行）。
    "wuchale",
    "msgctxt",
    "nplurals",
    "pofile",
    // 英文译文语料里的散文用词（`unhover` / `unacked` 同一类构词）：它们随 `examples.ts` 进
    // cspell 的检查面，是笔误之外的合法英文，登记而不是改写。
    "misalign",
    "unfocusable",
    "unclickable",
    "grabbable"
  ]
}
