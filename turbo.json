{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".mise.toml", "monorepo.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.spec.ts",
        "!**/*.spec.mjs",
        "!**/*.test.ts",
        "!**/*.test.mjs",
        "!**/__tests__/**"
      ],
      "outputs": ["dist/**", "bin/**"],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "check-generated": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "//#check-generated-parity": {
      "cache": true,
      "inputs": [
        "scripts/checks/**",
        "apps/react-web-ui-demo/src/generated/**",
        "apps/react-web-ui-demo/src/routes/components/**",
        "apps/vue-web-ui-demo/src/generated/**",
        "apps/vue-web-ui-demo/src/pages/components/**"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
